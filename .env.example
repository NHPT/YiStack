#
# YiStack 最小启动环境变量模板
#
# 规则：
# - 本文件只保留进程启动、数据库连接、JWT/CORS、前端代理和预览网关入口所需配置。
# - 系统限制、项目文件限制、LLM Provider、容器运行策略、Capability / Skill / MCP 执行策略等运行期配置，
#   必须通过后台配置或数据库表维护，避免修改环境变量后重启服务。
#

# ===========================================
# 应用启动配置
# ===========================================
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8080

# ===========================================
# 前端开发服务监听配置
# ===========================================
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5000

# ===========================================
# 后端与预览网关访问地址
# ===========================================
# Next.js 服务端代理与 Route Handler 使用 BACKEND_URL 访问 Go 后端。
BACKEND_URL=http://127.0.0.1:8080

# 浏览器端通常保持为空，直接走同源 /api。
NEXT_PUBLIC_API_URL=

# 预览网关仅作为内部代理目标监听；浏览器默认走同源 /preview Route Handler。
CONTAINER_PREVIEW_BIND_HOST=127.0.0.1
CONTAINER_PREVIEW_PORT=3100
CONTAINER_PREVIEW_URL=
# 可选：覆盖浏览器端预览入口。默认留空时使用同源 /preview，避免暴露宿主机预览端口。
NEXT_PUBLIC_PREVIEW_GATEWAY_URL=

# ===========================================
# 数据库配置
# ===========================================
# 当前默认使用 Supabase；未来直连数据库目标限定为 PostgreSQL / MySQL。
DB_TYPE=supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 设置后，YiStack 将通过 GORM 直连 Supabase PostgreSQL 并执行 SQL migrations；直连失败会阻断启动。
# 不设置则使用 REST API 模式，功能受限，且不执行 GORM migrations。
SUPABASE_DB_PASSWORD=
SUPABASE_DB_REGION=ap-southeast-2

# ===========================================
# GitHub OAuth / Webhook bootstrap
# ===========================================
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3000/api/github/oauth/callback
GITHUB_TOKEN_ENCRYPTION_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_URL=http://localhost:3000/api/github/webhook
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_WEB_BASE_URL=https://github.com

# ===========================================
# Vercel deployment adapter bootstrap
# ===========================================
VERCEL_ACCESS_TOKEN=
VERCEL_TEAM_ID=
VERCEL_API_BASE_URL=https://api.vercel.com
DEPLOYMENT_SECRET_ENCRYPTION_KEY=

# ===========================================
# JWT 认证配置
# ===========================================
JWT_EXPIRY=86400
REFRESH_TOKEN_EXPIRY=604800
# 生产环境必须设置至少 32 字节的随机值。留空或使用已知示例值时，
# YiStack 会为当前进程生成临时随机密钥，服务重启后现有登录状态失效。
JWT_SECRET=

# ===========================================
# CORS 配置
# ===========================================
# 默认使用同源访问；如需额外允许跨域来源，请填写完整 Origin，多个用英文逗号分隔。
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_EXPOSED_HEADERS=X-Request-Id,X-RateLimit-Limit,X-RateLimit-Remaining
CORS_MAX_AGE=86400

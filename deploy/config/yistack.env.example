# YiStack production configuration
# Copy to /etc/yistack/yistack.env and replace all required values.

APP_ENV=production
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8080
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5000
BACKEND_URL=http://127.0.0.1:8080
NEXT_PUBLIC_API_URL=

# Database mode: supabase (recommended for all application-backend features)
# or postgres (self-hosted YiStack control-plane database).
DB_TYPE=supabase
# Production schema is installed from database/init.sql and verified at startup.
DB_AUTO_MIGRATE=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_REGION=ap-southeast-2

# Used when DB_TYPE=postgres. The installer fills these values when invoked
# with --with-postgres.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=yistack
DB_SSL_MODE=disable

# The installer generates this value when the file is created. Keep at least
# 32 random bytes and retain it across upgrades.
JWT_SECRET=
# Token lifetimes are durations in seconds, not secret values.
JWT_EXPIRY=86400
REFRESH_TOKEN_EXPIRY=604800

CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_EXPOSED_HEADERS=X-Request-Id,X-RateLimit-Limit,X-RateLimit-Remaining
CORS_MAX_AGE=86400

CONTAINER_ENABLED=true
CONTAINER_RUNTIME=podman
CONTAINER_SOCKET_PATH=
CONTAINER_PROJECT_DIR=/var/lib/yistack/runtime/projects
CONTAINER_TEMPLATE_DIR=/var/lib/yistack/runtime/templates
CONTAINER_DATA_DIR=/var/lib/yistack/runtime/container-data
CONTAINER_PREVIEW_BIND_HOST=127.0.0.1
CONTAINER_PREVIEW_PORT=3100
CONTAINER_PREVIEW_URL=
CONTAINER_PREVIEW_SCHEME=https
CONTAINER_PREVIEW_BASE_DOMAIN=
CONTAINER_PREVIEW_TARGET_DOMAIN=
CONTAINER_PREVIEW_TARGET_PORT=0
CONTAINER_PREVIEW_TOKEN_TTL_SECONDS=900

YISTACK_INSTALL_DIR=/opt/yistack/current
YISTACK_CONFIG_DIR=/etc/yistack
YISTACK_DATA_DIR=/var/lib/yistack
YISTACK_LOG_DIR=/var/log/yistack
YISTACK_CACHE_DIR=/var/cache/yistack
YISTACK_BROWSER_EVIDENCE_DIR=/var/lib/yistack/runtime/generation-evidence
PLAYWRIGHT_BROWSERS_PATH=/var/lib/yistack/ms-playwright
YISTACK_SKIP_DOTENV=true

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=
GITHUB_TOKEN_ENCRYPTION_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_URL=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_WEB_BASE_URL=https://github.com

VERCEL_ACCESS_TOKEN=
VERCEL_TEAM_ID=
VERCEL_API_BASE_URL=https://api.vercel.com
DEPLOYMENT_SECRET_ENCRYPTION_KEY=

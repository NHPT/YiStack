# Optional ephemeral trial mode for a public YiStack instance.
# User and project data are restored to a clean baseline on schedule.
# This file is not installed or enabled by default.

DEMO_MAINTENANCE_ENABLED=false

# The baseline may contain administrator, provider, and system configuration,
# but snapshot creation refuses ordinary users, projects, or project workspaces.
DEMO_BASELINE_DIR=/var/lib/yistack/demo-baseline

# These systemd calendar expressions and randomized delays are applied with:
# sudo yistackctl demo apply-schedule
DEMO_RESET_ON_CALENDAR="*-*-* 04:00:00"
DEMO_RESET_RANDOMIZED_DELAY_SEC=10min
DEMO_CLEANUP_ON_CALENDAR="*-*-* *:30:00"
DEMO_CLEANUP_RANDOMIZED_DELAY_SEC=5min

# Hourly cleanup is an additional safeguard between full daily resets.
DEMO_PROJECT_TTL_HOURS=24

# Stopped project containers and transient files are removed after these
# retention periods. Set a value to 0 to disable an hourly cleanup category.
DEMO_STOPPED_CONTAINER_TTL_MINUTES=60
DEMO_EVIDENCE_TTL_HOURS=24
DEMO_CACHE_TTL_HOURS=24
DEMO_LOG_TTL_DAYS=7

# Disk pressure cleanup begins at the high watermark and removes the oldest
# non-baseline projects until the low watermark is reached.
DEMO_DISK_HIGH_WATERMARK_PERCENT=80
DEMO_DISK_LOW_WATERMARK_PERCENT=70

# A full reset removes all labeled project containers and networks, restores
# the clean database/workspace baseline, and clears managed container state,
# evidence, cache, and file logs. Reusable images and runtimes are retained.
DEMO_RESTART_AFTER_RESET=true
DEMO_HEALTH_TIMEOUT_SECONDS=120

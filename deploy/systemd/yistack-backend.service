[Unit]
Description=YiStack backend and Preview Gateway
After=network-online.target yistack-postgres.service
Wants=network-online.target
PartOf=yistack.target

[Service]
Type=simple
User=yistack
Group=yistack
EnvironmentFile=/etc/yistack/yistack.env
Environment=HOME=/var/lib/yistack
Environment=XDG_RUNTIME_DIR=/run/user/%U
WorkingDirectory=/opt/yistack/current
ExecStart=/opt/yistack/current/bin/yistack-server
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/yistack /var/log/yistack /var/cache/yistack

[Install]
WantedBy=yistack.target

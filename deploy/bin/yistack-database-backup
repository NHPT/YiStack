#!/usr/bin/env bash

set -euo pipefail

CONFIG_FILE="${YISTACK_ENV_FILE:-/etc/yistack/yistack.env}"
POSTGRES_CONFIG_FILE="${YISTACK_POSTGRES_ENV_FILE:-/etc/yistack/postgres.env}"
BACKUP_DIR="${YISTACK_DATABASE_BACKUP_DIR:-/var/lib/yistack/database-backups}"

usage() {
  cat <<'EOF'
Usage: yistack-database-backup {create|verify|restore} <backup-name>

Creates and verifies PostgreSQL custom-format backups used by YiStack upgrades.
Backup names may contain only letters, numbers, dots, underscores, and hyphens.
EOF
}

die() {
  echo "YiStack database backup failed: $*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "missing command: $1"
}

validate_backup_name() {
  local name="$1"
  [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] ||
    die "invalid backup name: $name"
}

load_database_config() {
  [ -r "$CONFIG_FILE" ] || die "YiStack configuration is missing: $CONFIG_FILE"

  set -a
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"
  set +a

  : "${DB_TYPE:=supabase}"
  : "${POSTGRES_IMAGE:=docker.io/library/postgres:16-alpine}"
  if [ -r "$POSTGRES_CONFIG_FILE" ]; then
    # shellcheck disable=SC1090
    source "$POSTGRES_CONFIG_FILE"
  fi

  case "$DB_TYPE" in
    postgres)
      DATABASE_HOST="${DB_HOST:-127.0.0.1}"
      DATABASE_PORT="${DB_PORT:-5432}"
      DATABASE_USER="${DB_USER:-postgres}"
      DATABASE_PASSWORD="${DB_PASSWORD:-}"
      DATABASE_NAME="${DB_NAME:-yistack}"
      DATABASE_SSL_MODE="${DB_SSL_MODE:-disable}"
      ;;
    supabase)
      local supabase_host project_ref
      [ -n "${SUPABASE_URL:-}" ] ||
        die "SUPABASE_URL is required for an upgrade backup"
      [ -n "${SUPABASE_DB_PASSWORD:-}" ] ||
        die "SUPABASE_DB_PASSWORD is required for an upgrade backup"
      supabase_host="${SUPABASE_URL#*://}"
      supabase_host="${supabase_host%%/*}"
      project_ref="${supabase_host%%.*}"
      if [ -z "$project_ref" ] ||
        [ "$supabase_host" != "${project_ref}.supabase.co" ] ||
        [[ ! "$project_ref" =~ ^[A-Za-z0-9-]+$ ]]; then
        die "SUPABASE_URL must use https://<project-ref>.supabase.co"
      fi
      DATABASE_HOST="db.${project_ref}.supabase.com"
      DATABASE_PORT=5432
      DATABASE_USER=postgres
      DATABASE_PASSWORD="$SUPABASE_DB_PASSWORD"
      DATABASE_NAME=postgres
      DATABASE_SSL_MODE=require
      ;;
    *)
      die "database backups support only PostgreSQL and Supabase, got $DB_TYPE"
      ;;
  esac

  [ -n "$DATABASE_PASSWORD" ] || die "database password is not configured"
  [[ "$DATABASE_PORT" =~ ^[0-9]+$ ]] || die "database port must be numeric"
  [ "$DATABASE_PORT" -ge 1 ] && [ "$DATABASE_PORT" -le 65535 ] ||
    die "database port must be between 1 and 65535"
  [ -n "$POSTGRES_IMAGE" ] && [[ "$POSTGRES_IMAGE" != -* ]] ||
    die "POSTGRES_IMAGE is invalid"
}

run_postgres_tool() {
  PGPASSWORD="$DATABASE_PASSWORD" \
  PGSSLMODE="$DATABASE_SSL_MODE" \
    podman run --rm --interactive --network host \
      --env PGPASSWORD \
      --env PGSSLMODE \
      "$POSTGRES_IMAGE" "$@"
}

run_postgres_tool_with_backup_mount() {
  PGPASSWORD="$DATABASE_PASSWORD" \
  PGSSLMODE="$DATABASE_SSL_MODE" \
    podman run --rm --interactive --network host \
      --env PGPASSWORD \
      --env PGSSLMODE \
      --volume "$BACKUP_DIR:/yistack-backups:ro" \
      "$POSTGRES_IMAGE" "$@"
}

backup_path_for_name() {
  printf '%s/%s.dump' "$BACKUP_DIR" "$1"
}

verify_backup() {
  local name="$1"
  local backup_path checksum_path checksum_line actual_checksum
  backup_path="$(backup_path_for_name "$name")"
  checksum_path="${backup_path}.sha256"

  [ -s "$backup_path" ] || die "backup is missing or empty: $backup_path"
  [ -s "$checksum_path" ] || die "backup checksum is missing: $checksum_path"
  checksum_line="$(< "$checksum_path")"
  if [[ ! "$checksum_line" =~ ^([0-9a-f]{64})\ \ ([A-Za-z0-9][A-Za-z0-9._-]*\.dump)$ ]] ||
    [ "${BASH_REMATCH[2]:-}" != "$(basename "$backup_path")" ]; then
    die "backup checksum file is invalid: $checksum_path"
  fi
  actual_checksum="$(sha256sum "$backup_path")"
  actual_checksum="${actual_checksum%% *}"
  [ "$actual_checksum" = "${BASH_REMATCH[1]}" ] ||
    die "backup checksum verification failed: $backup_path"
  run_postgres_tool pg_restore --list < "$backup_path" >/dev/null ||
    die "backup archive validation failed: $backup_path"
  printf '%s\n' "$backup_path"
}

create_backup() {
  local name="$1"
  local backup_path partial_path checksum_path
  backup_path="$(backup_path_for_name "$name")"
  partial_path="${backup_path}.partial"
  checksum_path="${backup_path}.sha256"

  mkdir -p "$BACKUP_DIR"
  chmod 0700 "$BACKUP_DIR"
  [ ! -e "$backup_path" ] || die "backup already exists: $backup_path"
  rm -f "$partial_path"

  if ! run_postgres_tool pg_dump \
    --host "$DATABASE_HOST" \
    --port "$DATABASE_PORT" \
    --username "$DATABASE_USER" \
    --dbname "$DATABASE_NAME" \
    --schema public \
    --format custom \
    --no-owner > "$partial_path"; then
    rm -f "$partial_path"
    die "pg_dump failed"
  fi
  if [ ! -s "$partial_path" ]; then
    rm -f "$partial_path"
    die "pg_dump produced an empty backup"
  fi
  if ! run_postgres_tool pg_restore --list < "$partial_path" >/dev/null; then
    rm -f "$partial_path"
    die "created backup archive is invalid"
  fi

  mv "$partial_path" "$backup_path"
  chmod 0600 "$backup_path"
  (
    cd "$BACKUP_DIR"
    sha256sum "$(basename "$backup_path")" > "$(basename "$checksum_path")"
  )
  chmod 0600 "$checksum_path"
  printf '%s\n' "$backup_path"
}

restore_backup() {
  local name="$1"
  local backup_path restore_list restore_list_partial
  backup_path="$(verify_backup "$name")"
  restore_list="${backup_path}.restore.list"
  restore_list_partial="${restore_list}.partial"
  rm -f "$restore_list" "$restore_list_partial"

  if ! run_postgres_tool pg_restore --list < "$backup_path" |
    awk '
      /^[0-9]+; [0-9]+ [0-9]+ SCHEMA - public / {
        public_schema_entries++
        next
      }
      { print }
      END { if (public_schema_entries != 1) exit 1 }
    ' > "$restore_list_partial"; then
    rm -f "$restore_list_partial"
    die "backup archive does not contain exactly one public schema entry"
  fi
  mv "$restore_list_partial" "$restore_list"
  chmod 0600 "$restore_list"

  if ! run_postgres_tool_with_backup_mount pg_restore \
    --host "$DATABASE_HOST" \
    --port "$DATABASE_PORT" \
    --username "$DATABASE_USER" \
    --dbname "$DATABASE_NAME" \
    --clean \
    --if-exists \
    --no-owner \
    --single-transaction \
    --exit-on-error \
    --use-list "/yistack-backups/$(basename "$restore_list")" \
    "/yistack-backups/$(basename "$backup_path")"; then
    rm -f "$restore_list"
    die "pg_restore failed"
  fi
  rm -f "$restore_list"
  printf '%s\n' "$backup_path"
}

main() {
  local command="${1:-}"
  local name="${2:-}"
  if [ "$#" -ne 2 ]; then
    usage >&2
    exit 2
  fi
  validate_backup_name "$name"
  require_command awk
  require_command podman
  require_command sha256sum
  load_database_config
  umask 077

  case "$command" in
    create)
      create_backup "$name"
      ;;
    verify)
      verify_backup "$name"
      ;;
    restore)
      restore_backup "$name"
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"

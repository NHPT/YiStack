#!/usr/bin/env bash

set -euo pipefail

CONFIG_FILE="${YISTACK_ENV_FILE:-/etc/yistack/yistack.env}"

read_config_value() {
  local key="$1"
  local fallback="$2"
  local value=""
  if [ -r "$CONFIG_FILE" ]; then
    value="$(sed -n "s/^${key}=//p" "$CONFIG_FILE" | tail -n 1)"
  fi
  printf '%s' "${value:-$fallback}"
}

run_as_service_user() {
  exec /opt/yistack/current/bin/yistack-service-user-exec "$@"
}

print_bash_completion() {
  cat <<'EOF'
_yistackctl() {
  local current="${COMP_WORDS[COMP_CWORD]}"
  local command="${COMP_WORDS[1]:-}"

  if [ "$COMP_CWORD" -eq 1 ]; then
    mapfile -t COMPREPLY < <(
      compgen -W \
        "start stop restart status logs health postgres database upgrade uninstall ephemeral completion help" \
        -- "$current"
    )
    return
  fi

  case "$command" in
    postgres)
      mapfile -t COMPREPLY < <(
        compgen -W "start init stop status logs" -- "$current"
      )
      ;;
    database)
      mapfile -t COMPREPLY < <(
        compgen -W "status plan migrate verify rollback" -- "$current"
      )
      ;;
    ephemeral)
      mapfile -t COMPREPLY < <(
        compgen -W \
          "snapshot reset cleanup enforce apply-schedule status" \
          -- "$current"
      )
      ;;
    completion)
      mapfile -t COMPREPLY < <(compgen -W "bash" -- "$current")
      ;;
    upgrade)
      mapfile -t COMPREPLY < <(compgen -f -- "$current")
      ;;
    uninstall)
      mapfile -t COMPREPLY < <(compgen -W "--purge --help" -- "$current")
      ;;
  esac
}

complete -F _yistackctl yistackctl
EOF
}

usage() {
  cat <<'EOF'
Usage: yistackctl <command> [arguments]

Service commands:
  start                         Start the YiStack application services
  stop                          Stop the YiStack application services
  restart                       Restart the YiStack application services
  status                        Show service status
  logs [SINCE]                  Follow service logs since today or SINCE
  health                        Verify backend and frontend health

Database and release commands:
  postgres {start|init|stop|status|logs}
  database {status|plan|migrate|verify|rollback}
  upgrade <release-directory|release.tar.gz>
  uninstall [--purge]           Remove YiStack; --purge also deletes local data

Ephemeral experience commands:
  ephemeral {snapshot|reset|cleanup|enforce|apply-schedule|status}

Shell integration:
  completion bash               Print Bash completion script
  help                          Show this help
EOF
}

run_release_upgrade() {
  (
    local source_path="$1"
    shift
    local release_root=""
    local temp_root=""
    local archive_name=""
    local archive_list=""
    local package_name=""
    local entry=""
    local link_path=""
    local resolved_path=""
    local special_path=""
    cleanup_release_upgrade() {
      [ -z "$temp_root" ] || rm -rf "$temp_root"
    }
    trap cleanup_release_upgrade EXIT

  if [ -d "$source_path" ]; then
    release_root="$(realpath "$source_path")"
  elif [ -f "$source_path" ] && [[ "$source_path" == *.tar.gz ]]; then
    source_path="$(realpath "$source_path")"
    archive_name="$(basename "$source_path")"
    package_name="${archive_name%.tar.gz}"
    [[ "$package_name" =~ ^yistack-v[0-9]+\.[0-9]+\.[0-9]+-linux-(amd64|arm64)$ ]] || {
      echo "Invalid YiStack Release archive name: $archive_name" >&2
      return 2
    }
    temp_root="$(mktemp -d)"
    chmod 0711 "$temp_root"
    archive_list="$temp_root/archive.list"
    if ! tar -tzf "$source_path" > "$archive_list"; then
      echo "Unable to read YiStack Release archive: $source_path" >&2
      return 1
    fi
    while IFS= read -r entry; do
      case "$entry" in
        "$package_name" | "$package_name/"*)
          ;;
        *)
          echo "Release archive entry escapes its package root: $entry" >&2
          return 1
          ;;
      esac
      case "/$entry/" in
        *"/../"* | *"/./"*)
          echo "Release archive contains an unsafe path: $entry" >&2
          return 1
          ;;
      esac
    done < "$archive_list"
    rm -f "$archive_list"
    tar --no-same-owner --no-same-permissions -xzf "$source_path" -C "$temp_root"
    release_root="$temp_root/$package_name"
    special_path="$(find "$release_root" \
      \( -type b -o -type c -o -type p -o -type s \) -print -quit)"
    [ -z "$special_path" ] || {
      echo "Release archive contains an unsupported special file: $special_path" >&2
      return 1
    }
    while IFS= read -r link_path; do
      resolved_path="$(realpath -m "$link_path")"
      case "$resolved_path" in
        "$release_root"/*)
          ;;
        *)
          echo "Release archive contains an external symlink: $link_path" >&2
          return 1
          ;;
      esac
      [ -e "$link_path" ] || {
        echo "Release archive contains a dangling symlink: $link_path" >&2
        return 1
      }
    done < <(find "$release_root" -type l -print)
  else
    echo "Usage: yistackctl upgrade <release-directory|release.tar.gz>" >&2
    return 2
  fi

  if [ ! -x "$release_root/upgrade.sh" ]; then
    echo "Release upgrade entrypoint is missing: $release_root/upgrade.sh" >&2
    return 1
  fi
    "$release_root/upgrade.sh" "$@"
  )
}

run_uninstall() {
  local script_path=""
  local script_dir=""
  local uninstall_source=""
  local temp_helper=""
  local temp_dir="${YISTACK_UNINSTALL_TMPDIR:-/run}"
  local status=0

  if [ "$(id -u)" -ne 0 ] && [ "${YISTACK_UNINSTALL_SKIP_ROOT_CHECK:-false}" != "true" ]; then
    echo "The uninstall command must run as root." >&2
    return 1
  fi
  script_path="$(realpath "${BASH_SOURCE[0]}")"
  script_dir="$(dirname "$script_path")"
  uninstall_source="$script_dir/yistack-uninstall"
  [ -x "$uninstall_source" ] || {
    echo "YiStack uninstall helper is missing: $uninstall_source" >&2
    return 1
  }
  temp_helper="$(mktemp "$temp_dir/yistack-uninstall.XXXXXX")"
  install -m 0700 "$uninstall_source" "$temp_helper"
  trap 'rm -f -- "$temp_helper"' RETURN
  "$temp_helper" "$@" || status=$?
  return "$status"
}

case "${1:-status}" in
  start)
    systemctl start yistack.target
    ;;
  stop)
    systemctl stop yistack.target
    ;;
  restart)
    systemctl restart yistack.target
    ;;
  status)
    systemctl --no-pager --full status \
      yistack-backend.service \
      yistack-frontend.service \
      yistack-browser-worker.service
    ;;
  logs)
    journalctl -u yistack-backend.service \
      -u yistack-frontend.service \
      -u yistack-browser-worker.service \
      --since "${2:-today}" -f
    ;;
  health)
    backend_port="$(read_config_value APP_PORT 8080)"
    frontend_port="$(read_config_value FRONTEND_PORT 5000)"
    case "$backend_port:$frontend_port" in
      *[!0-9:]* | :* | *:)
        echo "APP_PORT and FRONTEND_PORT must be numeric." >&2
        exit 1
        ;;
    esac
    curl --fail --silent --show-error "http://127.0.0.1:$backend_port/api/health"
    printf '\n'
    curl --fail --silent --show-error "http://127.0.0.1:$frontend_port/auth" >/dev/null
    echo "YiStack frontend and backend are healthy."
    ;;
  postgres)
    shift
    run_as_service_user \
      /opt/yistack/current/bin/yistack-postgres "${1:-status}"
    ;;
  database)
    shift
    database_command="${1:-status}"
    case "$database_command" in
      migrate | rollback)
        if systemctl is-active --quiet yistack.target ||
          systemctl is-active --quiet yistack-backend.service; then
          echo "Stop YiStack before changing the database schema: sudo yistackctl stop" >&2
          exit 1
        fi
        ;;
      status | plan | verify)
        ;;
      *)
        echo "Usage: yistackctl database {status|plan|migrate|verify|rollback}" >&2
        exit 2
        ;;
    esac
    if [ ! -r "$CONFIG_FILE" ]; then
      echo "YiStack configuration is missing: $CONFIG_FILE" >&2
      exit 1
    fi
    set -a
    # shellcheck disable=SC1090
    source "$CONFIG_FILE"
    set +a
    export YISTACK_SKIP_DOTENV=true
    export YISTACK_INSTALL_DIR="${YISTACK_INSTALL_DIR:-/opt/yistack/current}"
    export YISTACK_MIGRATIONS_DIR="${YISTACK_MIGRATIONS_DIR:-$YISTACK_INSTALL_DIR/database/migrations}"
    exec "$YISTACK_INSTALL_DIR/bin/yistack-server" database "$database_command"
    ;;
  upgrade)
    shift
    [ "$#" -ge 1 ] || {
      echo "Usage: yistackctl upgrade <release-directory|release.tar.gz>" >&2
      exit 2
    }
    release_source="$1"
    shift
    run_release_upgrade "$release_source" "$@"
    ;;
  uninstall)
    shift
    run_uninstall "$@"
    ;;
  ephemeral)
    shift
    exec /opt/yistack/current/bin/yistack-ephemeral-maintenance "${1:-status}"
    ;;
  completion)
    shift
    case "${1:-}" in
      bash)
        print_bash_completion
        ;;
      *)
        echo "Usage: yistackctl completion bash" >&2
        exit 2
        ;;
    esac
    ;;
  help | -h | --help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

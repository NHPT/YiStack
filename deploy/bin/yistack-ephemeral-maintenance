#!/usr/bin/env bash

set -euo pipefail

YISTACK_ENV_FILE="${YISTACK_ENV_FILE:-/etc/yistack/yistack.env}"
YISTACK_POSTGRES_ENV_FILE="${YISTACK_POSTGRES_ENV_FILE:-/etc/yistack/postgres.env}"
YISTACK_EPHEMERAL_ENV_FILE="${YISTACK_EPHEMERAL_ENV_FILE:-/etc/yistack/ephemeral-maintenance.env}"

if [ -r "$YISTACK_ENV_FILE" ]; then
  # shellcheck disable=SC1090
  source "$YISTACK_ENV_FILE"
fi
if [ -r "$YISTACK_EPHEMERAL_ENV_FILE" ]; then
  # shellcheck disable=SC1090
  source "$YISTACK_EPHEMERAL_ENV_FILE"
fi
if [ -n "${YISTACK_EPHEMERAL_LOCK_FILE:-}" ]; then
  EPHEMERAL_LOCK_FILE="$YISTACK_EPHEMERAL_LOCK_FILE"
fi

: "${YISTACK_INSTALL_DIR:=/opt/yistack/current}"
: "${YISTACK_DATA_DIR:=/var/lib/yistack}"
: "${YISTACK_LOG_DIR:=/var/log/yistack}"
: "${YISTACK_CACHE_DIR:=/var/cache/yistack}"
: "${CONTAINER_PROJECT_DIR:=$YISTACK_DATA_DIR/runtime/projects}"
: "${CONTAINER_TEMPLATE_DIR:=$YISTACK_DATA_DIR/runtime/templates}"
: "${CONTAINER_DATA_DIR:=$YISTACK_DATA_DIR/runtime/container-data}"
: "${PROJECT_BACKUP_DIR:=$YISTACK_DATA_DIR/runtime/backups}"
: "${YISTACK_BROWSER_EVIDENCE_DIR:=$YISTACK_DATA_DIR/runtime/generation-evidence}"
: "${PLAYWRIGHT_BROWSERS_PATH:=$YISTACK_DATA_DIR/ms-playwright}"
: "${EPHEMERAL_MAINTENANCE_ENABLED:=false}"
: "${EPHEMERAL_BASELINE_DIR:=$YISTACK_DATA_DIR/ephemeral-baseline}"
: "${EPHEMERAL_PROJECT_TTL_HOURS:=24}"
: "${EPHEMERAL_STOPPED_CONTAINER_TTL_MINUTES:=60}"
: "${EPHEMERAL_EVIDENCE_TTL_HOURS:=24}"
: "${EPHEMERAL_CACHE_TTL_HOURS:=24}"
: "${EPHEMERAL_LOG_TTL_DAYS:=7}"
: "${EPHEMERAL_DISK_HIGH_WATERMARK_PERCENT:=80}"
: "${EPHEMERAL_DISK_LOW_WATERMARK_PERCENT:=70}"
: "${EPHEMERAL_RESTART_AFTER_RESET:=true}"
: "${EPHEMERAL_HEALTH_TIMEOUT_SECONDS:=120}"
: "${EPHEMERAL_LOCK_FILE:=/run/lock/yistack-ephemeral-maintenance.lock}"
: "${EPHEMERAL_RESET_ON_CALENDAR:=*-*-* 04:00:00}"
: "${EPHEMERAL_RESET_RANDOMIZED_DELAY_SEC:=10min}"
: "${EPHEMERAL_CLEANUP_ON_CALENDAR:=*-*-* *:30:00}"
: "${EPHEMERAL_CLEANUP_RANDOMIZED_DELAY_SEC:=5min}"
: "${YISTACK_SYSTEMD_UNIT_DIR:=/etc/systemd/system}"
: "${SERVICE_USER:=yistack}"
: "${YISTACK_SERVICE_USER_EXEC:=$YISTACK_INSTALL_DIR/bin/yistack-service-user-exec}"
: "${YISTACK_EPHEMERAL_CONFIG_TEMPLATE:=$YISTACK_INSTALL_DIR/config/yistack-ephemeral-maintenance.env.example}"
: "${SYSTEMCTL_BIN:=systemctl}"

APP_RESTORE_ON_EXIT=false
RUNNING_CONTAINERS_FILE=""
TEMP_PATHS=()
POSTGRES_CONFIG_LOADED=false
EPHEMERAL_LOCK_FD=""
EPHEMERAL_USER_DATA_TABLES=(
  users
  projects
  project_files
  chat_messages
  commits
  project_engineering_states
  project_capability_execution_audits
  project_resource_alert_events
  project_resource_alert_action_claims
  generation_jobs
  generation_attempts
  generation_events
  github_connections
  github_oauth_states
  github_project_bindings
  github_sync_operations
  github_webhook_deliveries
  project_deployment_bindings
  project_deployment_releases
  project_deployment_domains
  project_deployment_operations
  enterprise_organizations
  enterprise_teams
  enterprise_members
  enterprise_project_ownerships
  enterprise_project_access_guard_activation_audits
  enterprise_audit_export_tasks
  enterprise_audit_export_delivery_reports
  enterprise_audit_export_worker_execution_requests
  project_members
  project_collaboration_audits
  project_collaboration_sessions
  project_collaboration_events
)

log() {
  printf '[ephemeral-maintenance] %s\n' "$*"
}

die() {
  printf '[ephemeral-maintenance] ERROR: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: yistackctl ephemeral {snapshot|enable|disable|reset|cleanup|enforce|apply-schedule|status}

  snapshot  Capture a baseline that excludes user and project data, even while disabled
  enable    Capture a fresh clean baseline, enable the mode, and start both schedules
  disable   Stop both schedules and disable the mode without deleting the baseline
  reset     Restore the clean baseline and remove managed transient data
  cleanup   Apply project, container, evidence, cache, and log retention rules
  enforce   Run cleanup and enforce the configured disk high/low watermarks
  apply-schedule
            Validate configured schedules and install systemd timer overrides
  status    Report configuration, baseline, resource, and disk status
EOF
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "Required command is missing: $1"
}

require_uint() {
  local name="$1"
  local value="$2"
  [[ "$value" =~ ^[0-9]+$ ]] || die "$name must be a non-negative integer"
}

require_bool() {
  local name="$1"
  local value="$2"
  case "$value" in
    true | false) ;;
    *) die "$name must be true or false" ;;
  esac
}

require_single_line() {
  local name="$1"
  local value="$2"
  [[ "$value" =~ [^[:space:]] ]] || die "$name must not be empty"
  case "$value" in
    *$'\n'* | *$'\r'*) die "$name must contain exactly one line" ;;
  esac
}

canonical_path() {
  realpath -m -- "$1"
}

assert_not_symlink() {
  local path="$1"
  [ ! -L "$path" ] || die "Managed path must not be a symbolic link: $path"
}

assert_safe_auxiliary_dir() {
  local name="$1"
  local path="$2"
  case "$path" in
    / | /etc | /opt | /usr | /var | /var/lib | /var/log | /var/cache)
      die "$name points at an unsafe directory: $path"
      ;;
  esac
  [[ "$path" = /*/*/* ]] || die "$name must contain at least three path components"
  assert_not_symlink "$path"
}

paths_overlap() {
  local first="$1"
  local second="$2"
  [ "$first" = "$second" ] ||
    [[ "$first" = "$second"/* ]] ||
    [[ "$second" = "$first"/* ]]
}

resolve_managed_paths() {
  DATA_DIR="$(canonical_path "$YISTACK_DATA_DIR")"
  TEMPLATE_DIR="$(canonical_path "$CONTAINER_TEMPLATE_DIR")"
  BROWSER_RUNTIME_DIR="$(canonical_path "$PLAYWRIGHT_BROWSERS_PATH")"
  PROJECT_DIR="$(canonical_path "$CONTAINER_PROJECT_DIR")"
  CONTAINER_STATE_DIR="$(canonical_path "$CONTAINER_DATA_DIR")"
  PROJECT_BACKUP_ROOT="$(canonical_path "$PROJECT_BACKUP_DIR")"
  EVIDENCE_DIR="$(canonical_path "$YISTACK_BROWSER_EVIDENCE_DIR")"
  BASELINE_DIR="$(canonical_path "$EPHEMERAL_BASELINE_DIR")"
  CACHE_DIR="$(canonical_path "$YISTACK_CACHE_DIR")"
  LOG_DIR="$(canonical_path "$YISTACK_LOG_DIR")"
  INSTALL_DIR="$(canonical_path "$YISTACK_INSTALL_DIR")"
  CONFIG_DIR="$(canonical_path "$(dirname "$YISTACK_ENV_FILE")")"

  [ "$TEMPLATE_DIR" = "$DATA_DIR/runtime/templates" ] ||
    die "CONTAINER_TEMPLATE_DIR must be YISTACK_DATA_DIR/runtime/templates"
  [ "$BROWSER_RUNTIME_DIR" = "$DATA_DIR/ms-playwright" ] ||
    die "PLAYWRIGHT_BROWSERS_PATH must be YISTACK_DATA_DIR/ms-playwright"
  [ "$PROJECT_DIR" = "$DATA_DIR/runtime/projects" ] ||
    die "CONTAINER_PROJECT_DIR must be YISTACK_DATA_DIR/runtime/projects"
  [ "$CONTAINER_STATE_DIR" = "$DATA_DIR/runtime/container-data" ] ||
    die "CONTAINER_DATA_DIR must be YISTACK_DATA_DIR/runtime/container-data"
  [ "$EVIDENCE_DIR" = "$DATA_DIR/runtime/generation-evidence" ] ||
    die "YISTACK_BROWSER_EVIDENCE_DIR must be inside the managed runtime"
  [ "$BASELINE_DIR" = "$DATA_DIR/ephemeral-baseline" ] ||
    die "EPHEMERAL_BASELINE_DIR must be YISTACK_DATA_DIR/ephemeral-baseline"

  assert_safe_auxiliary_dir YISTACK_DATA_DIR "$DATA_DIR"
  case "$DATA_DIR" in
    /etc/* | /opt/* | /usr/* | /run/*)
      die "YISTACK_DATA_DIR must not be inside a protected system directory"
      ;;
  esac
  for path in "$DATA_DIR" "$TEMPLATE_DIR" "$BROWSER_RUNTIME_DIR" "$PROJECT_DIR" \
    "$CONTAINER_STATE_DIR" "$PROJECT_BACKUP_ROOT" "$EVIDENCE_DIR" "$BASELINE_DIR"; do
    assert_not_symlink "$path"
  done
  assert_safe_auxiliary_dir PROJECT_BACKUP_DIR "$PROJECT_BACKUP_ROOT"
  for protected_dir in "$PROJECT_DIR" "$TEMPLATE_DIR" "$BROWSER_RUNTIME_DIR" \
    "$CONTAINER_STATE_DIR" "$EVIDENCE_DIR" "$BASELINE_DIR" "$INSTALL_DIR" "$CONFIG_DIR"; do
    if paths_overlap "$PROJECT_BACKUP_ROOT" "$protected_dir"; then
      die "PROJECT_BACKUP_DIR must not overlap another managed or protected directory"
    fi
  done
  assert_safe_auxiliary_dir YISTACK_CACHE_DIR "$CACHE_DIR"
  assert_safe_auxiliary_dir YISTACK_LOG_DIR "$LOG_DIR"
  for auxiliary_dir in "$CACHE_DIR" "$LOG_DIR"; do
    for protected_dir in "$DATA_DIR" "$INSTALL_DIR" "$CONFIG_DIR"; do
      if paths_overlap "$auxiliary_dir" "$protected_dir"; then
        die "Cache and log directories must not overlap data, configuration, or installed Releases"
      fi
    done
  done
  if paths_overlap "$CACHE_DIR" "$LOG_DIR"; then
    die "YISTACK_CACHE_DIR and YISTACK_LOG_DIR must not overlap"
  fi
}

validate_configuration() {
  require_bool EPHEMERAL_MAINTENANCE_ENABLED "$EPHEMERAL_MAINTENANCE_ENABLED"
  require_bool EPHEMERAL_RESTART_AFTER_RESET "$EPHEMERAL_RESTART_AFTER_RESET"
  require_uint EPHEMERAL_PROJECT_TTL_HOURS "$EPHEMERAL_PROJECT_TTL_HOURS"
  require_uint EPHEMERAL_STOPPED_CONTAINER_TTL_MINUTES "$EPHEMERAL_STOPPED_CONTAINER_TTL_MINUTES"
  require_uint EPHEMERAL_EVIDENCE_TTL_HOURS "$EPHEMERAL_EVIDENCE_TTL_HOURS"
  require_uint EPHEMERAL_CACHE_TTL_HOURS "$EPHEMERAL_CACHE_TTL_HOURS"
  require_uint EPHEMERAL_LOG_TTL_DAYS "$EPHEMERAL_LOG_TTL_DAYS"
  require_uint EPHEMERAL_DISK_HIGH_WATERMARK_PERCENT "$EPHEMERAL_DISK_HIGH_WATERMARK_PERCENT"
  require_uint EPHEMERAL_DISK_LOW_WATERMARK_PERCENT "$EPHEMERAL_DISK_LOW_WATERMARK_PERCENT"
  require_uint EPHEMERAL_HEALTH_TIMEOUT_SECONDS "$EPHEMERAL_HEALTH_TIMEOUT_SECONDS"
  require_single_line EPHEMERAL_RESET_ON_CALENDAR "$EPHEMERAL_RESET_ON_CALENDAR"
  require_single_line EPHEMERAL_RESET_RANDOMIZED_DELAY_SEC "$EPHEMERAL_RESET_RANDOMIZED_DELAY_SEC"
  require_single_line EPHEMERAL_CLEANUP_ON_CALENDAR "$EPHEMERAL_CLEANUP_ON_CALENDAR"
  require_single_line EPHEMERAL_CLEANUP_RANDOMIZED_DELAY_SEC "$EPHEMERAL_CLEANUP_RANDOMIZED_DELAY_SEC"

  (( EPHEMERAL_DISK_LOW_WATERMARK_PERCENT >= 1 )) ||
    die "EPHEMERAL_DISK_LOW_WATERMARK_PERCENT must be at least 1"
  (( EPHEMERAL_DISK_HIGH_WATERMARK_PERCENT <= 99 )) ||
    die "EPHEMERAL_DISK_HIGH_WATERMARK_PERCENT must be less than 100"
  (( EPHEMERAL_DISK_LOW_WATERMARK_PERCENT < EPHEMERAL_DISK_HIGH_WATERMARK_PERCENT )) ||
    die "The disk low watermark must be lower than the high watermark"
  (( EPHEMERAL_HEALTH_TIMEOUT_SECONDS >= 10 )) ||
    die "EPHEMERAL_HEALTH_TIMEOUT_SECONDS must be at least 10"

  resolve_managed_paths
}

require_enabled() {
  [ -r "$YISTACK_EPHEMERAL_ENV_FILE" ] ||
    die "Ephemeral experience mode configuration is missing: $YISTACK_EPHEMERAL_ENV_FILE"
  [ "$EPHEMERAL_MAINTENANCE_ENABLED" = "true" ] ||
    die "Ephemeral experience mode is disabled; set EPHEMERAL_MAINTENANCE_ENABLED=true explicitly"
}

reload_ephemeral_configuration() {
  [ -r "$YISTACK_EPHEMERAL_ENV_FILE" ] ||
    die "Ephemeral experience mode configuration is missing: $YISTACK_EPHEMERAL_ENV_FILE"
  # shellcheck disable=SC1090
  source "$YISTACK_EPHEMERAL_ENV_FILE"
  if [ -n "${YISTACK_EPHEMERAL_LOCK_FILE:-}" ]; then
    EPHEMERAL_LOCK_FILE="$YISTACK_EPHEMERAL_LOCK_FILE"
  fi
}

ensure_ephemeral_configuration() {
  local config_dir
  [ ! -L "$YISTACK_EPHEMERAL_ENV_FILE" ] ||
    die "Ephemeral experience mode configuration must not be a symbolic link: $YISTACK_EPHEMERAL_ENV_FILE"
  if [ -f "$YISTACK_EPHEMERAL_ENV_FILE" ]; then
    return 0
  fi
  [ -f "$YISTACK_EPHEMERAL_CONFIG_TEMPLATE" ] ||
    die "Ephemeral experience mode configuration template is missing: $YISTACK_EPHEMERAL_CONFIG_TEMPLATE"
  config_dir="$(dirname "$YISTACK_EPHEMERAL_ENV_FILE")"
  install -d -m 0750 "$config_dir"
  install -m 0640 "$YISTACK_EPHEMERAL_CONFIG_TEMPLATE" "$YISTACK_EPHEMERAL_ENV_FILE"
  if [ "$(id -u)" -eq 0 ]; then
    chown root:"$SERVICE_USER" "$YISTACK_EPHEMERAL_ENV_FILE"
  fi
  # shellcheck disable=SC1090
  source "$YISTACK_EPHEMERAL_ENV_FILE"
  log "Ephemeral experience mode configuration created at $YISTACK_EPHEMERAL_ENV_FILE"
}

set_ephemeral_enabled() {
  local value="$1"
  local temp_file
  require_bool EPHEMERAL_MAINTENANCE_ENABLED "$value"
  ensure_ephemeral_configuration
  temp_file="$(mktemp "${YISTACK_EPHEMERAL_ENV_FILE}.tmp.XXXXXX")"
  TEMP_PATHS+=("$temp_file")
  awk -v value="$value" '
    BEGIN { found = 0 }
    /^[[:space:]]*EPHEMERAL_MAINTENANCE_ENABLED[[:space:]]*=/ {
      if (found == 0) {
        print "EPHEMERAL_MAINTENANCE_ENABLED=" value
        found = 1
      }
      next
    }
    { print }
    END {
      if (found == 0) {
        print "EPHEMERAL_MAINTENANCE_ENABLED=" value
      }
    }
  ' "$YISTACK_EPHEMERAL_ENV_FILE" > "$temp_file"
  chmod 0640 "$temp_file"
  if [ "$(id -u)" -eq 0 ]; then
    chown root:"$SERVICE_USER" "$temp_file"
  fi
  mv -f -- "$temp_file" "$YISTACK_EPHEMERAL_ENV_FILE"
  EPHEMERAL_MAINTENANCE_ENABLED="$value"
}

load_postgres_configuration() {
  [ "$POSTGRES_CONFIG_LOADED" = "true" ] && return 0
  [ "${DB_TYPE:-}" = "postgres" ] ||
    die "Ephemeral experience mode supports only DB_TYPE=postgres; external Supabase is refused"
  [ -r "$YISTACK_POSTGRES_ENV_FILE" ] ||
    die "PostgreSQL configuration is missing: $YISTACK_POSTGRES_ENV_FILE"
  # shellcheck disable=SC1090
  source "$YISTACK_POSTGRES_ENV_FILE"
  : "${POSTGRES_CONTAINER_NAME:=yistack-postgres}"
  : "${POSTGRES_USER:=postgres}"
  : "${POSTGRES_DB:=yistack}"
  [[ "$POSTGRES_DB" =~ ^[A-Za-z_][A-Za-z0-9_-]*$ ]] ||
    die "POSTGRES_DB contains unsupported characters"
  case "$POSTGRES_DB" in
    postgres | template0 | template1)
      die "POSTGRES_DB must be a dedicated YiStack database"
      ;;
  esac
  POSTGRES_CONFIG_LOADED=true
}

run_as_service() (
  local lock_fd="$EPHEMERAL_LOCK_FD"
  local command_status
  if [ "$(id -u)" -eq 0 ] && [ "$(id -un)" != "$SERVICE_USER" ]; then
    [ -x "$YISTACK_SERVICE_USER_EXEC" ] ||
      die "service-user execution helper is missing: $YISTACK_SERVICE_USER_EXEC"
    export YISTACK_SERVICE_USER="$SERVICE_USER"
    export YISTACK_DATA_DIR="$DATA_DIR"
    set -- "$YISTACK_SERVICE_USER_EXEC" env PATH="$PATH" "$@"
  fi
  set +e
  if [ -n "$lock_fd" ]; then
    "$@" {lock_fd}>&-
  else
    "$@"
  fi
  command_status="$?"
  exit "$command_status"
)

podman_cmd() {
  run_as_service podman "$@"
}

postgres_psql() {
  podman_cmd exec -i "$POSTGRES_CONTAINER_NAME" \
    psql -X -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d "$POSTGRES_DB" "$@"
}

postgres_query() {
  postgres_psql -qAt "$@"
}

ensure_postgres_running() {
  load_postgres_configuration
  if command -v "$SYSTEMCTL_BIN" >/dev/null 2>&1; then
    "$SYSTEMCTL_BIN" start yistack-postgres.service
  else
    run_as_service "$YISTACK_INSTALL_DIR/bin/yistack-postgres" start
  fi
  [ "$(podman_cmd inspect --format '{{.State.Running}}' "$POSTGRES_CONTAINER_NAME" 2>/dev/null || true)" = "true" ] ||
    die "The managed PostgreSQL container is not running"
}

acquire_lock() {
  local failure_message="${1:-Another ephemeral experience maintenance operation is already running}"
  local inherited_fd="${YISTACK_EPHEMERAL_LOCK_FD:-}"
  require_command flock
  install -d -m 0755 "$(dirname "$EPHEMERAL_LOCK_FILE")"
  if [ -n "$inherited_fd" ]; then
    [[ "$inherited_fd" =~ ^[0-9]+$ ]] ||
      die "YISTACK_EPHEMERAL_LOCK_FD must be a file descriptor number"
    [ -e "/proc/$$/fd/$inherited_fd" ] ||
      die "Inherited ephemeral maintenance lock descriptor is not open"
    [ "/proc/$$/fd/$inherited_fd" -ef "$EPHEMERAL_LOCK_FILE" ] ||
      die "Inherited ephemeral maintenance lock descriptor does not match EPHEMERAL_LOCK_FILE"
    flock -n "$inherited_fd" || die "$failure_message"
    EPHEMERAL_LOCK_FD="$inherited_fd"
    return 0
  fi
  exec 9>"$EPHEMERAL_LOCK_FILE"
  flock -n 9 || die "$failure_message"
  EPHEMERAL_LOCK_FD=9
}

pause_application() {
  if "$SYSTEMCTL_BIN" is-active --quiet yistack.target; then
    "$SYSTEMCTL_BIN" stop yistack.target
    APP_RESTORE_ON_EXIT=true
  fi
}

resume_application() {
  if [ "$APP_RESTORE_ON_EXIT" = "true" ]; then
    "$SYSTEMCTL_BIN" start yistack.target
    APP_RESTORE_ON_EXIT=false
  fi
}

restore_running_containers() {
  [ -n "$RUNNING_CONTAINERS_FILE" ] || return 0
  if [ -f "$RUNNING_CONTAINERS_FILE" ]; then
    while IFS= read -r container_id; do
      [ -n "$container_id" ] || continue
      podman_cmd start "$container_id" >/dev/null 2>&1 || true
    done < "$RUNNING_CONTAINERS_FILE"
    rm -f -- "$RUNNING_CONTAINERS_FILE"
  fi
  RUNNING_CONTAINERS_FILE=""
}

cleanup_on_exit() {
  local rc=$?
  trap - EXIT
  restore_running_containers
  if [ "$APP_RESTORE_ON_EXIT" = "true" ]; then
    "$SYSTEMCTL_BIN" start yistack.target >/dev/null 2>&1 || true
  fi
  for path in "${TEMP_PATHS[@]}"; do
    [ -n "$path" ] && rm -rf -- "$path"
  done
  exit "$rc"
}
trap cleanup_on_exit EXIT

project_id_is_safe() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]]
}

project_has_running_container() {
  local project_id="$1"
  local container_id label
  while IFS= read -r container_id; do
    [ -n "$container_id" ] || continue
    label="$(podman_cmd container inspect --format '{{ index .Config.Labels "yistack.project_id" }}' "$container_id" 2>/dev/null || true)"
    [ "$label" = "$project_id" ] && return 0
  done < <(podman_cmd ps -q --filter "label=yistack.project_id=$project_id" --filter status=running)
  return 1
}

remove_project_resources() {
  local project_id="$1"
  local resource_id label
  project_id_is_safe "$project_id" || die "Refusing unsafe project ID: $project_id"

  while IFS= read -r resource_id; do
    [ -n "$resource_id" ] || continue
    label="$(podman_cmd container inspect --format '{{ index .Config.Labels "yistack.project_id" }}' "$resource_id" 2>/dev/null || true)"
    [ "$label" = "$project_id" ] || continue
    podman_cmd rm --force "$resource_id" >/dev/null
  done < <(podman_cmd ps -aq --filter "label=yistack.project_id=$project_id")

  while IFS= read -r resource_id; do
    [ -n "$resource_id" ] || continue
    label="$(podman_cmd network inspect --format '{{ index .Labels "yistack.project_id" }}' "$resource_id" 2>/dev/null || true)"
    [ "$label" = "$project_id" ] || continue
    podman_cmd network rm --force "$resource_id" >/dev/null
  done < <(podman_cmd network ls -q --filter "label=yistack.project_id=$project_id")
}

remove_all_project_resources() {
  local resource_id label
  while IFS= read -r resource_id; do
    [ -n "$resource_id" ] || continue
    label="$(podman_cmd container inspect --format '{{ index .Config.Labels "yistack.project_id" }}' "$resource_id" 2>/dev/null || true)"
    [ -n "$label" ] || continue
    podman_cmd rm --force "$resource_id" >/dev/null
  done < <(podman_cmd ps -aq --filter label=yistack.project_id)

  while IFS= read -r resource_id; do
    [ -n "$resource_id" ] || continue
    label="$(podman_cmd network inspect --format '{{ index .Labels "yistack.project_id" }}' "$resource_id" 2>/dev/null || true)"
    [ -n "$label" ] || continue
    podman_cmd network rm --force "$resource_id" >/dev/null
  done < <(podman_cmd network ls -q --filter label=yistack.project_id)
}

delete_project() {
  local project_id="$1"
  local force_active="${2:-false}"
  local project_path
  project_id_is_safe "$project_id" || die "Refusing unsafe project ID: $project_id"
  if [ "$force_active" != "true" ] && project_has_running_container "$project_id"; then
    log "Active trial project retained despite its TTL: $project_id"
    return 0
  fi

  remove_project_resources "$project_id"
  printf '%s\n' "DELETE FROM public.projects WHERE project_id = :'project_id';" |
    postgres_psql -q -v "project_id=$project_id"
  project_path="$PROJECT_DIR/$project_id"
  [ "$(canonical_path "$project_path")" = "$PROJECT_DIR/$project_id" ] ||
    die "Project workspace escaped its managed root: $project_path"
  rm -rf -- "$project_path"
  log "Removed expired trial project: $project_id"
}

clear_directory_contents() {
  local path="$1"
  case "$path" in
    "$CONTAINER_STATE_DIR" | "$PROJECT_BACKUP_ROOT" | "$EVIDENCE_DIR" | "$CACHE_DIR" | "$LOG_DIR") ;;
    *) die "Refusing to clear unmanaged directory: $path" ;;
  esac
  install -d -m 0750 -o "$SERVICE_USER" -g "$SERVICE_USER" "$path"
  find "$path" -xdev -mindepth 1 -delete
}

delete_aged_files() {
  local path="$1"
  local minutes="$2"
  [ "$minutes" -gt 0 ] || return 0
  [ -d "$path" ] || return 0
  find "$path" -xdev -mindepth 1 -type f -mmin "+$minutes" -delete
  find "$path" -xdev -depth -mindepth 1 -type d -empty -delete
}

cleanup_transient_files() {
  delete_aged_files "$EVIDENCE_DIR" "$((EPHEMERAL_EVIDENCE_TTL_HOURS * 60))"
  delete_aged_files "$CACHE_DIR" "$((EPHEMERAL_CACHE_TTL_HOURS * 60))"
  delete_aged_files "$LOG_DIR" "$((EPHEMERAL_LOG_TTL_DAYS * 1440))"
}

cleanup_stopped_containers() {
  local container_id full_id label finished_at finished_epoch cutoff now index
  local container_ids=()
  local project_ids=()
  [ "$EPHEMERAL_STOPPED_CONTAINER_TTL_MINUTES" -gt 0 ] || return 0
  now="$(date +%s)"
  cutoff="$((now - EPHEMERAL_STOPPED_CONTAINER_TTL_MINUTES * 60))"
  while IFS= read -r container_id; do
    [ -n "$container_id" ] || continue
    label="$(podman_cmd container inspect --format '{{ index .Config.Labels "yistack.project_id" }}' "$container_id" 2>/dev/null || true)"
    project_id_is_safe "$label" || continue
    [ "$(podman_cmd container inspect --format '{{.State.Running}}' "$container_id" 2>/dev/null || true)" = "false" ] || continue
    finished_at="$(podman_cmd container inspect --format '{{.State.FinishedAt}}' "$container_id" 2>/dev/null || true)"
    finished_epoch="$(date -d "$finished_at" +%s 2>/dev/null || true)"
    [ -n "$finished_epoch" ] || continue
    if [ "$finished_epoch" -le "$cutoff" ]; then
      full_id="$(podman_cmd container inspect --format '{{.Id}}' "$container_id")"
      container_ids+=("$full_id")
      project_ids+=("$label")
    fi
  done < <(podman_cmd ps -aq --filter label=yistack.project_id)

  [ "${#container_ids[@]}" -gt 0 ] || return 0
  pause_application
  for index in "${!container_ids[@]}"; do
    container_id="${container_ids[$index]}"
    label="${project_ids[$index]}"
    podman_cmd rm --force "$container_id" >/dev/null
    printf '%s\n' "UPDATE public.projects SET container_id = NULL, container_name = NULL, container_port = NULL, container_status = 'stopped' WHERE project_id = :'project_id' AND container_id = :'container_id';" |
      postgres_psql -q -v "project_id=$label" -v "container_id=$container_id"
    log "Removed stopped project container: $container_id"
  done
  resume_application
}

expired_project_ids() {
  [ "$EPHEMERAL_PROJECT_TTL_HOURS" -gt 0 ] || return 0
  postgres_query -c \
    "SELECT project_id FROM public.projects WHERE deleted_at IS NOT NULL OR updated_at < now() - make_interval(hours => $EPHEMERAL_PROJECT_TTL_HOURS) ORDER BY updated_at NULLS FIRST, project_id;"
}

oldest_project_ids() {
  postgres_query -c \
    'SELECT project_id FROM public.projects ORDER BY updated_at NULLS FIRST, project_id;'
}

cleanup_expired_projects() {
  local project_ids=()
  local project_id
  mapfile -t project_ids < <(expired_project_ids)
  [ "${#project_ids[@]}" -gt 0 ] || return 0
  pause_application
  for project_id in "${project_ids[@]}"; do
    [ -n "$project_id" ] || continue
    delete_project "$project_id"
  done
  resume_application
}

disk_usage_percent() {
  df -P "$DATA_DIR" | awk 'NR == 2 { value=$5; gsub(/%/, "", value); print value }'
}

enforce_disk_watermarks() {
  local usage project_id removed=false
  usage="$(disk_usage_percent)"
  require_uint disk_usage_percent "$usage"
  if [ "$usage" -lt "$EPHEMERAL_DISK_HIGH_WATERMARK_PERCENT" ]; then
    return 0
  fi

  ensure_postgres_running
  log "Disk usage ${usage}% reached the ${EPHEMERAL_DISK_HIGH_WATERMARK_PERCENT}% high watermark"
  pause_application
  while IFS= read -r project_id; do
    [ -n "$project_id" ] || continue
    delete_project "$project_id" true
    removed=true
    usage="$(disk_usage_percent)"
    if [ "$usage" -le "$EPHEMERAL_DISK_LOW_WATERMARK_PERCENT" ]; then
      break
    fi
  done < <(oldest_project_ids)
  resume_application

  usage="$(disk_usage_percent)"
  if [ "$usage" -gt "$EPHEMERAL_DISK_LOW_WATERMARK_PERCENT" ]; then
    [ "$removed" = "true" ] || log "No projects were eligible for pressure cleanup"
    die "Disk usage remains ${usage}% after bounded cleanup; operator action is required"
  fi
}

stop_running_project_containers() {
  RUNNING_CONTAINERS_FILE="$(mktemp)"
  TEMP_PATHS+=("$RUNNING_CONTAINERS_FILE")
  podman_cmd ps -q --filter label=yistack.project_id --filter status=running > "$RUNNING_CONTAINERS_FILE"
  while IFS= read -r container_id; do
    [ -n "$container_id" ] || continue
    podman_cmd stop --time 20 "$container_id" >/dev/null
  done < "$RUNNING_CONTAINERS_FILE"
}

write_baseline_metadata() {
  local destination="$1"
  local version=unknown source_commit=unknown
  [ -r "$YISTACK_INSTALL_DIR/VERSION" ] && version="$(tr -d '[:space:]' < "$YISTACK_INSTALL_DIR/VERSION")"
  [ -r "$YISTACK_INSTALL_DIR/SOURCE_COMMIT" ] && source_commit="$(tr -d '[:space:]' < "$YISTACK_INSTALL_DIR/SOURCE_COMMIT")"
  cat > "$destination" <<EOF
schema=ephemeral-experience-baseline.v2
created_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
version=$version
source_commit=$source_commit
db_type=postgres
db_name=$POSTGRES_DB
project_dir=$PROJECT_DIR
user_data_policy=excluded
EOF
}

metadata_value() {
  local key="$1"
  awk -F= -v key="$key" '$1 == key { sub(/^[^=]*=/, ""); print; exit }' "$BASELINE_DIR/METADATA"
}

verify_baseline() {
  local expected_commit current_commit
  for file in FILES.sha256 METADATA database.dump workspace.tar.gz; do
    [ -f "$BASELINE_DIR/$file" ] || die "Baseline is incomplete: $BASELINE_DIR/$file"
  done
  (
    cd "$BASELINE_DIR"
    sha256sum --check --quiet FILES.sha256
  ) || die "Baseline checksum verification failed"
  [ "$(metadata_value schema)" = "ephemeral-experience-baseline.v2" ] ||
    die "Unsupported ephemeral experience baseline schema"
  [ "$(metadata_value db_type)" = "postgres" ] ||
    die "Ephemeral experience baseline database type is not PostgreSQL"
  [ "$(metadata_value user_data_policy)" = "excluded" ] ||
    die "Ephemeral experience baseline does not exclude user data"
  [ "$(metadata_value db_name)" = "$POSTGRES_DB" ] || die "Baseline database name does not match POSTGRES_DB"
  [ "$(metadata_value project_dir)" = "$PROJECT_DIR" ] || die "Baseline project directory does not match this installation"

  expected_commit="$(metadata_value source_commit)"
  current_commit=unknown
  [ -r "$YISTACK_INSTALL_DIR/SOURCE_COMMIT" ] && current_commit="$(tr -d '[:space:]' < "$YISTACK_INSTALL_DIR/SOURCE_COMMIT")"
  [ "$expected_commit" = "$current_commit" ] ||
    die "Baseline source commit differs from the installed release; capture a new baseline"
}

list_user_data_rows() {
  postgres_query -c "
WITH user_data_rows(table_name, row_count) AS (
  VALUES
    ('users', (SELECT count(*)::bigint FROM public.users)),
    ('projects', (SELECT count(*)::bigint FROM public.projects)),
    ('project_files', (SELECT count(*)::bigint FROM public.project_files)),
    ('chat_messages', (SELECT count(*)::bigint FROM public.chat_messages)),
    ('commits', (SELECT count(*)::bigint FROM public.commits)),
    ('project_engineering_states', (SELECT count(*)::bigint FROM public.project_engineering_states)),
    ('project_capability_execution_audits', (SELECT count(*)::bigint FROM public.project_capability_execution_audits)),
    ('project_resource_alert_events', (SELECT count(*)::bigint FROM public.project_resource_alert_events)),
    ('generation_jobs', (SELECT count(*)::bigint FROM public.generation_jobs)),
    ('generation_attempts', (SELECT count(*)::bigint FROM public.generation_attempts)),
    ('generation_events', (SELECT count(*)::bigint FROM public.generation_events)),
    ('github_connections', (SELECT count(*)::bigint FROM public.github_connections)),
    ('github_oauth_states', (SELECT count(*)::bigint FROM public.github_oauth_states)),
    ('github_project_bindings', (SELECT count(*)::bigint FROM public.github_project_bindings)),
    ('github_sync_operations', (SELECT count(*)::bigint FROM public.github_sync_operations)),
    ('github_webhook_deliveries', (SELECT count(*)::bigint FROM public.github_webhook_deliveries)),
    ('project_deployment_bindings', (SELECT count(*)::bigint FROM public.project_deployment_bindings)),
    ('project_deployment_releases', (SELECT count(*)::bigint FROM public.project_deployment_releases)),
    ('project_deployment_domains', (SELECT count(*)::bigint FROM public.project_deployment_domains)),
    ('project_deployment_operations', (SELECT count(*)::bigint FROM public.project_deployment_operations)),
    ('enterprise_organizations', (SELECT count(*)::bigint FROM public.enterprise_organizations)),
    ('enterprise_teams', (SELECT count(*)::bigint FROM public.enterprise_teams)),
    ('enterprise_members', (SELECT count(*)::bigint FROM public.enterprise_members)),
    ('enterprise_project_ownerships', (SELECT count(*)::bigint FROM public.enterprise_project_ownerships)),
    ('enterprise_project_access_guard_activation_audits', (SELECT count(*)::bigint FROM public.enterprise_project_access_guard_activation_audits)),
    ('enterprise_audit_export_tasks', (SELECT count(*)::bigint FROM public.enterprise_audit_export_tasks)),
    ('enterprise_audit_export_delivery_reports', (SELECT count(*)::bigint FROM public.enterprise_audit_export_delivery_reports)),
    ('enterprise_audit_export_worker_execution_requests', (SELECT count(*)::bigint FROM public.enterprise_audit_export_worker_execution_requests)),
    ('project_members', (SELECT count(*)::bigint FROM public.project_members)),
    ('project_collaboration_audits', (SELECT count(*)::bigint FROM public.project_collaboration_audits)),
    ('project_collaboration_sessions', (SELECT count(*)::bigint FROM public.project_collaboration_sessions)),
    ('project_collaboration_events', (SELECT count(*)::bigint FROM public.project_collaboration_events))
)
SELECT table_name || ':' || row_count
FROM user_data_rows
WHERE row_count > 0
ORDER BY table_name;"
}

assert_no_database_user_data() {
  local context="$1"
  local dirty_rows
  dirty_rows="$(list_user_data_rows)"
  if [ -n "$dirty_rows" ]; then
    printf '%s\n' "$dirty_rows" >&2
    die "$context contains user data; all listed tables must be empty"
  fi
}

assert_empty_project_workspaces() {
  local context="$1"
  local first_workspace=""
  if [ -d "$PROJECT_DIR" ]; then
    first_workspace="$(find "$PROJECT_DIR" -xdev -mindepth 1 -maxdepth 1 -print -quit)"
  fi
  [ -z "$first_workspace" ] ||
    die "$context contains a project workspace: $first_workspace"
}

snapshot_baseline() {
  local parent temp_dir previous_dir table
  local dump_args=()
  ensure_postgres_running
  pause_application
  stop_running_project_containers
  install -d -m 0750 -o "$SERVICE_USER" -g "$SERVICE_USER" "$PROJECT_DIR"

  parent="$(dirname "$BASELINE_DIR")"
  install -d -m 0750 "$parent"
  if [ "$(id -u)" -eq 0 ]; then
    chown root:"$SERVICE_USER" "$parent"
  fi
  temp_dir="$(mktemp -d "${BASELINE_DIR}.tmp.XXXXXX")"
  TEMP_PATHS+=("$temp_dir")

  for table in "${EPHEMERAL_USER_DATA_TABLES[@]}"; do
    dump_args+=("--exclude-table-data=public.$table")
  done
  podman_cmd exec "$POSTGRES_CONTAINER_NAME" \
    pg_dump -U "$POSTGRES_USER" -d "$POSTGRES_DB" \
      --format=custom --no-owner --no-privileges \
      "${dump_args[@]}" > "$temp_dir/database.dump"
  tar --sort=name --numeric-owner -czf "$temp_dir/workspace.tar.gz" --files-from /dev/null
  write_baseline_metadata "$temp_dir/METADATA"
  (
    cd "$temp_dir"
    sha256sum database.dump workspace.tar.gz > FILES.sha256
  )
  chmod 0750 "$temp_dir"
  chmod 0640 "$temp_dir"/*
  if [ "$(id -u)" -eq 0 ]; then
    chown -R root:"$SERVICE_USER" "$temp_dir"
  fi

  previous_dir="${BASELINE_DIR}.previous"
  rm -rf -- "$previous_dir"
  if [ -d "$BASELINE_DIR" ]; then
    mv "$BASELINE_DIR" "$previous_dir"
  fi
  if ! mv "$temp_dir" "$BASELINE_DIR"; then
    [ -d "$previous_dir" ] && mv "$previous_dir" "$BASELINE_DIR"
    die "Failed to activate the new ephemeral experience baseline"
  fi
  rm -rf -- "$previous_dir"
  TEMP_PATHS=()
  restore_running_containers
  resume_application
  log "Clean ephemeral experience baseline captured at $BASELINE_DIR"
}

restore_database() {
  podman_cmd exec "$POSTGRES_CONTAINER_NAME" \
    dropdb --if-exists --force -U "$POSTGRES_USER" "$POSTGRES_DB"
  podman_cmd exec "$POSTGRES_CONTAINER_NAME" \
    createdb -U "$POSTGRES_USER" -O "$POSTGRES_USER" "$POSTGRES_DB"
  podman_cmd exec -i "$POSTGRES_CONTAINER_NAME" \
    pg_restore -U "$POSTGRES_USER" -d "$POSTGRES_DB" \
      --exit-on-error --no-owner --no-privileges < "$BASELINE_DIR/database.dump"
  postgres_psql -q -c \
    "UPDATE public.projects SET container_id = NULL, container_name = NULL, container_port = NULL, container_status = 'stopped';"
  [ "$(postgres_query -c "SELECT count(*) FROM public.schema_migrations WHERE version = '000000000000_contributor_alpha';")" = "1" ] ||
    die "Restored database is missing the YiStack baseline migration"
  assert_no_database_user_data "Restored ephemeral experience baseline"
}

restore_workspaces() {
  local stage_dir old_dir
  stage_dir="${PROJECT_DIR}.reset.$$"
  old_dir="${PROJECT_DIR}.old.$$"
  TEMP_PATHS+=("$stage_dir" "$old_dir")
  rm -rf -- "$stage_dir" "$old_dir"
  install -d -m 0750 -o "$SERVICE_USER" -g "$SERVICE_USER" "$stage_dir"
  tar -xzf "$BASELINE_DIR/workspace.tar.gz" -C "$stage_dir" --no-same-owner
  chown -R "$SERVICE_USER:$SERVICE_USER" "$stage_dir"

  if [ -d "$PROJECT_DIR" ]; then
    mv "$PROJECT_DIR" "$old_dir"
  fi
  if ! mv "$stage_dir" "$PROJECT_DIR"; then
    [ -d "$old_dir" ] && mv "$old_dir" "$PROJECT_DIR"
    die "Failed to activate restored project workspaces"
  fi
  rm -rf -- "$old_dir"
  TEMP_PATHS=()
  assert_empty_project_workspaces "Restored ephemeral experience baseline"
}

wait_for_health() {
  local deadline
  deadline="$(( $(date +%s) + EPHEMERAL_HEALTH_TIMEOUT_SECONDS ))"
  until "$YISTACK_INSTALL_DIR/bin/yistackctl" health >/dev/null 2>&1; do
    if [ "$(date +%s)" -ge "$deadline" ]; then
      die "YiStack did not become healthy after the ephemeral experience reset"
    fi
    sleep 2
  done
}

reset_to_baseline() {
  ensure_postgres_running
  verify_baseline
  "$SYSTEMCTL_BIN" stop yistack.target
  APP_RESTORE_ON_EXIT=false
  remove_all_project_resources
  restore_database
  restore_workspaces
  clear_directory_contents "$CONTAINER_STATE_DIR"
  clear_directory_contents "$PROJECT_BACKUP_ROOT"
  clear_directory_contents "$EVIDENCE_DIR"
  clear_directory_contents "$CACHE_DIR"
  clear_directory_contents "$LOG_DIR"

  if [ "$EPHEMERAL_RESTART_AFTER_RESET" = "true" ]; then
    "$SYSTEMCTL_BIN" start yistack.target
    wait_for_health
  fi
  log "Ephemeral experience state restored from the verified clean baseline"
}

run_cleanup() {
  ensure_postgres_running
  cleanup_stopped_containers
  cleanup_expired_projects
  cleanup_transient_files
}

validate_timer_setting() {
  local setting_name="$1"
  local analyzer_command="$2"
  local value="$3"
  if ! systemd-analyze "$analyzer_command" "$value" >/dev/null 2>&1; then
    die "$setting_name is not a valid systemd $analyzer_command value: $value"
  fi
}

write_timer_override() {
  local timer_name="$1"
  local calendar="$2"
  local randomized_delay="$3"
  local override_dir="$SYSTEMD_UNIT_DIR/${timer_name}.d"
  local temp_file
  install -d -m 0755 "$override_dir" || return 1
  temp_file="$(mktemp "$override_dir/.10-schedule.conf.XXXXXX")" || return 1
  TEMP_PATHS+=("$temp_file")
  {
    printf '[Timer]\n'
    printf 'OnCalendar=\n'
    printf 'OnCalendar=%s\n' "$calendar"
    printf 'RandomizedDelaySec=%s\n' "$randomized_delay"
  } > "$temp_file" || return 1
  chmod 0644 "$temp_file" || return 1
  mv -f -- "$temp_file" "$override_dir/10-schedule.conf" || return 1
}

apply_timer_schedule() {
  SYSTEMD_UNIT_DIR="$(canonical_path "$YISTACK_SYSTEMD_UNIT_DIR")" || return 1
  [[ "$SYSTEMD_UNIT_DIR" = /*/*/* ]] ||
    die "YISTACK_SYSTEMD_UNIT_DIR must contain at least three path components"
  assert_not_symlink "$SYSTEMD_UNIT_DIR"
  if [ "$SYSTEMD_UNIT_DIR" = "/etc/systemd/system" ] && [ "$(id -u)" -ne 0 ]; then
    die "Applying the ephemeral experience schedule requires root privileges"
  fi

  validate_timer_setting EPHEMERAL_RESET_ON_CALENDAR calendar "$EPHEMERAL_RESET_ON_CALENDAR"
  validate_timer_setting EPHEMERAL_RESET_RANDOMIZED_DELAY_SEC timespan "$EPHEMERAL_RESET_RANDOMIZED_DELAY_SEC"
  validate_timer_setting EPHEMERAL_CLEANUP_ON_CALENDAR calendar "$EPHEMERAL_CLEANUP_ON_CALENDAR"
  validate_timer_setting EPHEMERAL_CLEANUP_RANDOMIZED_DELAY_SEC timespan "$EPHEMERAL_CLEANUP_RANDOMIZED_DELAY_SEC"
  write_timer_override \
    yistack-ephemeral-reset.timer \
    "$EPHEMERAL_RESET_ON_CALENDAR" \
    "$EPHEMERAL_RESET_RANDOMIZED_DELAY_SEC" || return 1
  write_timer_override \
    yistack-ephemeral-cleanup.timer \
    "$EPHEMERAL_CLEANUP_ON_CALENDAR" \
    "$EPHEMERAL_CLEANUP_RANDOMIZED_DELAY_SEC" || return 1
  "$SYSTEMCTL_BIN" daemon-reload || return 1
  "$SYSTEMCTL_BIN" enable --now \
    yistack-ephemeral-reset.timer \
    yistack-ephemeral-cleanup.timer || return 1
  "$SYSTEMCTL_BIN" restart \
    yistack-ephemeral-reset.timer \
    yistack-ephemeral-cleanup.timer || return 1
  log "Ephemeral experience schedules applied"
}

stop_ephemeral_maintenance_units() {
  local failed=false
  if ! "$SYSTEMCTL_BIN" disable --now \
    yistack-ephemeral-reset.timer \
    yistack-ephemeral-cleanup.timer; then
    failed=true
  fi
  if ! "$SYSTEMCTL_BIN" stop \
    yistack-ephemeral-reset.service \
    yistack-ephemeral-cleanup.service; then
    failed=true
  fi
  [ "$failed" = "false" ]
}

prepare_enable_mode() {
  set_ephemeral_enabled false
  stop_ephemeral_maintenance_units ||
    die "Ephemeral mode was marked disabled, but maintenance units could not be fully stopped before enable"
}

enable_mode() {
  local baseline_existed=false
  local rollback_dir="${BASELINE_DIR}.enable-rollback.$$"
  rm -rf -- "$rollback_dir"
  if [ -e "$BASELINE_DIR" ] || [ -L "$BASELINE_DIR" ]; then
    cp -a -- "$BASELINE_DIR" "$rollback_dir" ||
      die "Failed to preserve the previous baseline before enable"
    baseline_existed=true
  fi
  local snapshot_status enable_status
  set +e
  (set -e; snapshot_baseline)
  snapshot_status="$?"
  set -e
  if [ "$snapshot_status" -ne 0 ]; then
    rm -rf -- "$BASELINE_DIR"
    if [ "$baseline_existed" = "true" ]; then
      mv -- "$rollback_dir" "$BASELINE_DIR" ||
        die "Failed to restore the previous baseline after snapshot failure"
    fi
    die "Failed to enable ephemeral experience mode while capturing a new baseline"
  fi
  set +e
  (
    set -e
    set_ephemeral_enabled true
    apply_timer_schedule
  )
  enable_status="$?"
  set -e
  if [ "$enable_status" -ne 0 ]; then
    set_ephemeral_enabled false
    stop_ephemeral_maintenance_units >/dev/null 2>&1 || true
    rm -rf -- "$BASELINE_DIR"
    if [ "$baseline_existed" = "true" ]; then
      mv -- "$rollback_dir" "$BASELINE_DIR" ||
        die "Failed to restore the previous baseline after enable failure"
    fi
    die "Failed to enable ephemeral experience mode; the mode remains disabled"
  fi
  EPHEMERAL_MAINTENANCE_ENABLED=true
  rm -rf -- "$rollback_dir"
  log "Ephemeral experience mode enabled"
}

disable_mode() {
  set_ephemeral_enabled false
  stop_ephemeral_maintenance_units ||
    die "Ephemeral mode was marked disabled, but maintenance units could not be fully stopped"
  log "Ephemeral experience mode disabled; the baseline was preserved"
}

show_status() {
  local baseline_status=missing usage=unknown project_count=unknown
  local reset_timer=inactive cleanup_timer=inactive
  local reset_timer_enabled=false cleanup_timer_enabled=false
  local expected_commit current_commit
  if [ "${DB_TYPE:-}" = "postgres" ] && [ -r "$YISTACK_POSTGRES_ENV_FILE" ]; then
    load_postgres_configuration
  fi
  if [ -d "$BASELINE_DIR" ] &&
    [ -f "$BASELINE_DIR/FILES.sha256" ] &&
    [ -f "$BASELINE_DIR/METADATA" ] &&
    [ -f "$BASELINE_DIR/database.dump" ] &&
    [ -f "$BASELINE_DIR/workspace.tar.gz" ]; then
    if (cd "$BASELINE_DIR" && sha256sum --check --quiet FILES.sha256 2>/dev/null); then
      if [ "$(metadata_value schema)" != "ephemeral-experience-baseline.v2" ] ||
        [ "$(metadata_value db_type)" != "postgres" ] ||
        [ "$(metadata_value user_data_policy)" != "excluded" ] ||
        [ "$(metadata_value project_dir)" != "$PROJECT_DIR" ] ||
        [ "$POSTGRES_CONFIG_LOADED" != "true" ] ||
        [ "$(metadata_value db_name)" != "$POSTGRES_DB" ]; then
        baseline_status=invalid
      else
        baseline_status=verified
        expected_commit="$(metadata_value source_commit)"
        current_commit=unknown
        [ -r "$YISTACK_INSTALL_DIR/SOURCE_COMMIT" ] &&
          current_commit="$(tr -d '[:space:]' < "$YISTACK_INSTALL_DIR/SOURCE_COMMIT")"
        if [ "$expected_commit" != "$current_commit" ]; then
          baseline_status=stale
        fi
      fi
    else
      baseline_status=invalid
    fi
  elif [ -e "$BASELINE_DIR" ]; then
    baseline_status=invalid
  fi
  if command -v "$SYSTEMCTL_BIN" >/dev/null 2>&1; then
    "$SYSTEMCTL_BIN" is-active --quiet yistack-ephemeral-reset.timer 2>/dev/null && reset_timer=active
    "$SYSTEMCTL_BIN" is-active --quiet yistack-ephemeral-cleanup.timer 2>/dev/null && cleanup_timer=active
    "$SYSTEMCTL_BIN" is-enabled --quiet yistack-ephemeral-reset.timer 2>/dev/null && reset_timer_enabled=true
    "$SYSTEMCTL_BIN" is-enabled --quiet yistack-ephemeral-cleanup.timer 2>/dev/null && cleanup_timer_enabled=true
  fi
  usage="$(disk_usage_percent 2>/dev/null || printf unknown)"
  if [ "$POSTGRES_CONFIG_LOADED" = "true" ]; then
    if [ "$(podman_cmd inspect --format '{{.State.Running}}' "$POSTGRES_CONTAINER_NAME" 2>/dev/null || true)" = "true" ]; then
      project_count="$(postgres_query -c 'SELECT count(*) FROM public.projects;' 2>/dev/null || printf unknown)"
    fi
  fi
  printf 'enabled=%s\n' "$EPHEMERAL_MAINTENANCE_ENABLED"
  printf 'reset_timer=%s\n' "$reset_timer"
  printf 'cleanup_timer=%s\n' "$cleanup_timer"
  printf 'reset_timer_enabled=%s\n' "$reset_timer_enabled"
  printf 'cleanup_timer_enabled=%s\n' "$cleanup_timer_enabled"
  printf 'database_mode=%s\n' "${DB_TYPE:-unset}"
  printf 'baseline=%s\n' "$baseline_status"
  printf 'baseline_dir=%s\n' "$BASELINE_DIR"
  printf 'project_count=%s\n' "$project_count"
  printf 'disk_usage_percent=%s\n' "$usage"
  printf 'project_ttl_hours=%s\n' "$EPHEMERAL_PROJECT_TTL_HOURS"
  printf 'disk_watermarks=%s/%s\n' "$EPHEMERAL_DISK_HIGH_WATERMARK_PERCENT" "$EPHEMERAL_DISK_LOW_WATERMARK_PERCENT"
  printf 'configured_reset_on_calendar=%s\n' "$EPHEMERAL_RESET_ON_CALENDAR"
  printf 'configured_reset_randomized_delay=%s\n' "$EPHEMERAL_RESET_RANDOMIZED_DELAY_SEC"
  printf 'configured_cleanup_on_calendar=%s\n' "$EPHEMERAL_CLEANUP_ON_CALENDAR"
  printf 'configured_cleanup_randomized_delay=%s\n' "$EPHEMERAL_CLEANUP_RANDOMIZED_DELAY_SEC"
}

main() {
  local command="${1:-status}"
  if [ "$command" = "disable" ]; then
    acquire_lock "A maintenance operation is still running; retry disable after it finishes"
    ensure_ephemeral_configuration
    reload_ephemeral_configuration
    require_command "$SYSTEMCTL_BIN"
    disable_mode
    return 0
  fi
  case "$command" in
    snapshot)
      acquire_lock "A maintenance operation is still running; retry snapshot after it finishes"
      ensure_ephemeral_configuration
      reload_ephemeral_configuration
      ;;
    enable)
      acquire_lock "A maintenance operation is still running; retry enable after it finishes"
      ensure_ephemeral_configuration
      reload_ephemeral_configuration
      prepare_enable_mode
      ;;
    apply-schedule | reset | cleanup | enforce)
      acquire_lock
      reload_ephemeral_configuration
      require_enabled
      ;;
  esac
  require_command realpath
  require_command sha256sum
  validate_configuration

  case "$command" in
    status)
      show_status
      ;;
    enable)
      require_command systemd-analyze
      enable_mode
      show_status
      ;;
    apply-schedule)
      require_command "$SYSTEMCTL_BIN"
      require_command systemd-analyze
      apply_timer_schedule
      ;;
    snapshot)
      require_command date
      require_command find
      require_command podman
      require_command runuser
      require_command "$SYSTEMCTL_BIN"
      require_command tar
      snapshot_baseline
      ;;
    reset | cleanup | enforce)
      require_command date
      require_command find
      require_command podman
      require_command runuser
      require_command "$SYSTEMCTL_BIN"
      require_command tar
      case "$command" in
        reset) reset_to_baseline ;;
        cleanup) run_cleanup ;;
        enforce) enforce_disk_watermarks ;;
      esac
      ;;
    -h | --help | help)
      usage
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi

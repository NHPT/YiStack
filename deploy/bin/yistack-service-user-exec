#!/usr/bin/env bash

set -Eeuo pipefail

SERVICE_USER="${YISTACK_SERVICE_USER:-yistack}"
DATA_DIR="${YISTACK_DATA_DIR:-/var/lib/yistack}"
RUNUSER_BIN="${YISTACK_RUNUSER_BIN:-runuser}"
SKIP_ROOT_CHECK="${YISTACK_SERVICE_EXEC_SKIP_ROOT_CHECK:-false}"

die() {
  echo "YiStack service-user execution failed: $*" >&2
  exit 1
}

[ "$#" -gt 0 ] || die "a command is required"
[[ "$DATA_DIR" = /* ]] || die "YISTACK_DATA_DIR must be an absolute path"
[ -d "$DATA_DIR" ] || die "YiStack data directory is missing: $DATA_DIR"

service_uid="$(id -u "$SERVICE_USER")" || die "service user is missing: $SERVICE_USER"
cd "$DATA_DIR"

if [ "$(id -u)" -eq 0 ] || [ "$SKIP_ROOT_CHECK" = "true" ]; then
  exec "$RUNUSER_BIN" -u "$SERVICE_USER" -- env \
    HOME="$DATA_DIR" \
    XDG_RUNTIME_DIR="/run/user/$service_uid" \
    "$@"
fi

if [ "$(id -un)" = "$SERVICE_USER" ]; then
  exec env \
    HOME="$DATA_DIR" \
    XDG_RUNTIME_DIR="/run/user/$service_uid" \
    "$@"
fi

die "command must run as root or $SERVICE_USER"

    "@types/express": "^5.0.6",
    "@types/node": "20.19.30",
    "@types/pg": "8.16.0",
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.3",
    "only-allow": "1.2.2",
    "tailwindcss": "4.1.18",
    "tsup": "8.5.1",

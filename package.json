{
  "name": "yistack",
  "version": "1.0.0",
  "private": true,
  "description": "YiStack - 从自然语言需求到可运行、可验证、可迭代应用的开源 AI 工程工作台",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22 <23",
    "pnpm": "11.5.2"
  },
  "scripts": {
    "build": "bash ./scripts/build.sh",
    "check:admin-runtime-readiness": "pnpm exec tsx scripts/validate-admin-runtime-health-diagnostics-model.ts",
    "checkout:verify": "bash ./scripts/verify-clean-checkout.sh",
    "contributor:validate": "node scripts/validate-contributor-alpha.mjs",
    "db:verify": "bash ./scripts/verify-supabase-baseline.sh",
    "dev": "bash ./scripts/dev.sh",
    "preinstall": "npx only-allow pnpm",
    "lint": "eslint",
    "release:audit": "bash ./scripts/audit-public-release.sh",
    "smoke:check": "bash ./scripts/smoke-check.sh",
    "start": "bash ./scripts/start.sh",
    "ts-check": "tsc -p tsconfig.json",
    "yes:validate": "bash ./scripts/validate-yes.sh",
    "browser:worker": "node scripts/browser-acceptance-worker.mjs",
    "browser:install": "playwright install chromium",
    "eval:canonical": "node scripts/run-generation-benchmark.mjs",
    "eval:smoke": "node scripts/run-generation-benchmark.mjs --limit 1",
    "eval:smoke:ci": "node scripts/validate-generation-benchmark-model.mjs",
    "test:vis001-browser": "node scripts/validate-vis001-browser-acceptance.mjs",
    "test:collab001-browser": "node scripts/validate-collab001-browser-acceptance.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/lib-storage": "^3.1121.0",
    "@hookform/resolvers": "^5.2.2",

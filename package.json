  "repository": {
    "type": "git",
    "url": "git+https://github.com/NHPT/YiStack.git"
  },
  "bugs": {
    "url": "https://github.com/NHPT/YiStack/issues"
  },
  "homepage": "https://github.com/NHPT/YiStack#readme",
  "keywords": [
    "ai",
    "ai-code-generation",
    "app-builder",
    "code-generation",
    "developer-tools",
    "full-stack",
    "golang",
